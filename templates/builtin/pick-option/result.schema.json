{
  "description": "A pick: choice (an option id) and an optional note. None of these: decision request_changes with a required note and no choice.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "choice",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "choice": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
          "description": "The id of the picked option."
        },
        "note": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional note, may be empty."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "decision",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "request_changes"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S",
          "description": "What is missing from these options."
        }
      }
    }
  ]
}
