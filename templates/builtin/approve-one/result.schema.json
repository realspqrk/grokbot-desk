{
  "description": "approve, reject, done, skipped or acknowledged: the comment is optional. request_changes (bot with allow_changes, or actor none): the comment is required. done and skipped are the user actor. acknowledged is actor none.",
  "oneOf": [
    {
      "type": "object",
      "required": ["decision", "comment"],
      "additionalProperties": false,
      "properties": {
        "decision": {"enum": ["approve", "reject", "done", "skipped", "acknowledged"]},
        "comment": {"type": "string", "maxLength": 2000, "description": "Optional note, may be empty."}
      }
    },
    {
      "type": "object",
      "required": ["decision", "comment"],
      "additionalProperties": false,
      "properties": {
        "decision": {"const": "request_changes"},
        "comment": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S", "description": "What should change."}
      }
    }
  ]
}
