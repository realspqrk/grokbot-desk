{
  "type": "object",
  "required": [
    "author",
    "text",
    "hashtags",
    "platforms"
  ],
  "additionalProperties": false,
  "x-rs-exclusive": [
    "image",
    "video"
  ],
  "properties": {
    "persona": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Optional voice or persona the draft was written in; a quiet line in the overflow menu."
    },
    "post_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Optional id of this post draft at the agent; a quiet line in the overflow menu."
    },
    "author": {
      "type": "object",
      "required": [
        "name",
        "handle"
      ],
      "additionalProperties": false,
      "description": "The account the post is published from.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "handle": {
          "type": "string",
          "pattern": "^[^\\s@]{1,30}$",
          "description": "Without @; X shows it as @handle."
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "LinkedIn headline under the name."
        },
        "avatar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "x-rs-media": true,
          "description": "Absolute image path under a media root."
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63206,
      "description": "Post text for every platform without a variant."
    },
    "hashtags": {
      "type": "array",
      "maxItems": 30,
      "description": "Stored without #; appended as \"#a #b\" after a blank line when hashtag_mode is append. At most 30 here; Instagram blocks auto approval above 5. A platform's variants[p].hashtags replaces this list for that platform.",
      "items": {
        "type": "string",
        "pattern": "^[^\\s#]{1,100}$"
      }
    },
    "hashtag_mode": {
      "enum": [
        "append",
        "none"
      ],
      "default": "append"
    },
    "first_comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1250,
      "description": "Optional first comment the reviewer posts under the post."
    },
    "link": {
      "type": "object",
      "required": [
        "url",
        "title",
        "domain"
      ],
      "additionalProperties": false,
      "description": "Link card, rendered from these fields only (nothing is fetched). Shown when there is no image.",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "path",
        "alt",
        "ratio"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "x-rs-media": true,
          "description": "Absolute image path under a media root."
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "ratio": {
          "enum": [
            "1:1",
            "4:5",
            "3:4",
            "9:16",
            "1.91:1",
            "16:9"
          ]
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "path",
        "poster",
        "alt",
        "ratio"
      ],
      "additionalProperties": false,
      "description": "Optional video in place of image (the two cannot both be set). The preview shows the poster and plays the file inline. Instagram treats a video as the required media.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "x-rs-media": "video",
          "description": "Absolute .mp4 or .webm path under a media root, at most 200 MB."
        },
        "poster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "x-rs-media": true,
          "description": "Poster image, required with a video. Absolute image path under a media root."
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "ratio": {
          "enum": [
            "1:1",
            "4:5",
            "3:4",
            "9:16",
            "1.91:1",
            "16:9"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false,
      "description": "Optional quoted post or reply parent. Not part of the composed text: X does not count this URL.",
      "properties": {
        "type": {
          "enum": [
            "quote",
            "reply"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "x-rs-url": "https",
          "description": "https address the opener accepts (hostname or IPv6, valid port, no credentials). Uppercase scheme and a zero-padded port are accepted. http is not."
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "description": "The account being quoted or replied to. Both fields are optional.",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "handle": {
              "type": "string",
              "pattern": "^[^\\s@]{1,30}$",
              "description": "Without @."
            }
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "The platform tabs, in order. Either plain ids (every platform auto) or objects {platform, mode}. mode auto (the default): the bot posts after the approval. mode manual: the reviewer posts it by hand and marks it as posted; the bot never posts it. One form per list.",
      "oneOf": [
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "x",
              "linkedin",
              "instagram",
              "facebook"
            ]
          }
        },
        {
          "type": "array",
          "x-rs-unique-key": "platform",
          "items": {
            "type": "object",
            "required": [
              "platform"
            ],
            "additionalProperties": false,
            "properties": {
              "platform": {
                "enum": [
                  "x",
                  "linkedin",
                  "instagram",
                  "facebook"
                ]
              },
              "mode": {
                "enum": [
                  "auto",
                  "manual"
                ],
                "default": "auto",
                "description": "auto: the bot posts after the approval. manual: the reviewer posts it and marks it as posted."
              }
            }
          },
          "minItems": 1
        }
      ]
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per platform: `text` replaces `text` and `hashtags` replaces `hashtags` for that platform (give one or both).",
      "properties": {
        "x": {
          "description": "Text and/or hashtags for this platform; at least one of the two.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63206
                },
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "hashtags"
              ],
              "additionalProperties": false,
              "properties": {
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            }
          ]
        },
        "linkedin": {
          "description": "Text and/or hashtags for this platform; at least one of the two.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63206
                },
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "hashtags"
              ],
              "additionalProperties": false,
              "properties": {
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            }
          ]
        },
        "instagram": {
          "description": "Text and/or hashtags for this platform; at least one of the two.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63206
                },
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "hashtags"
              ],
              "additionalProperties": false,
              "properties": {
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            }
          ]
        },
        "facebook": {
          "description": "Text and/or hashtags for this platform; at least one of the two.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63206
                },
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "hashtags"
              ],
              "additionalProperties": false,
              "properties": {
                "hashtags": {
                  "type": "array",
                  "maxItems": 30,
                  "description": "Hashtags for this platform only, replacing `hashtags` (same item rules).",
                  "items": {
                    "type": "string",
                    "pattern": "^[^\\s#]{1,100}$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "The agent's note to the reviewer, shown above the previews."
    },
    "flag": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "description": "Characters or words the post should avoid (house style); any found in the composed text or the first comment are named in one quiet style note. Never blocks approving.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      }
    }
  }
}
