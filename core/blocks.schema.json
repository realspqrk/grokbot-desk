  "post": {
    "type": "object",
    "required": [
      "type",
      "author",
      "text",
      "hashtags",
      "platforms"
    ],
    "additionalProperties": false,
    "x-rs-exclusive": [
      "image",
      "video"
    ],
    "description": "Input: a social post preview per platform.",
    "properties": {
      "type": {
        "const": "post"
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$",
        "description": "Optional, unique in the report. Without it the block is b<position> (b1 is the first block)."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Optional heading above the block."
      },
      "persona": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "Optional voice or persona the draft was written in; a quiet line in the overflow menu."
      },
      "post_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "description": "Optional id of this post draft at the agent; a quiet line in the overflow menu."
      },
      "author": {
        "type": "object",
        "required": [
          "name",
          "handle"
        ],
        "additionalProperties": false,
        "description": "The account the post is published from.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "handle": {
            "type": "string",
            "pattern": "^[^\\s@]{1,30}$",
            "description": "Without @; X shows it as @handle."
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "LinkedIn headline under the name."
          },
          "avatar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "x-rs-media": true,
            "description": "Absolute image path under a media root."
          }
        }
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63206,
        "description": "Post text for every platform without a variant."
      },
      "hashtags": {
        "type": "array",
        "maxItems": 30,
        "description": "Stored without #; appended as \"#a #b\" after a blank line when hashtag_mode is append. At most 30 here; Instagram blocks auto approval above 5. A platform's variants[p].hashtags replaces this list for that platform.",
        "items": {
          "type": "string",
          "pattern": "^[^\\s#]{1,100}$"
        }
      },
      "hashtag_mode": {
        "enum": [
          "append",
          "none"
        ],
        "default": "append"
      },
      "first_comment": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1250,
        "description": "Optional first comment the reviewer posts under the post."
      },
