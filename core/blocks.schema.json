{
  "text": {
    "type": "object",
    "required": [
      "type",
      "md"
    ],
    "additionalProperties": false,
    "description": "Markdown prose: headings, lists, tables, callouts, code, links, images by key.",
    "properties": {
      "type": {
        "const": "text"
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$",
        "description": "Optional, unique in the report. Without it the block is b<position> (b1 is the first block)."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Optional heading above the block."
      },
      "md": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60000,
        "description": "Markdown. Raw HTML is shown as text. ## and ### headings can be replied to."
      },
      "collapsed": {
        "type": "boolean",
        "default": false,
        "description": "Start folded behind the title."
      },
      "images": {
        "type": "array",
        "maxItems": 8,
        "x-rs-unique-key": "key",
        "items": {
          "type": "object",
          "required": [
            "key",
            "path",
            "alt"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
              "description": "Name used in the Markdown image target."
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "x-rs-media": true,
              "description": "Absolute image path under a media root (png, jpg, jpeg, webp, gif)."
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Alt text, used when the Markdown gives none."
            }
          }
        }
      }
    }
  },
  "stats": {
    "type": "object",
    "required": [
      "type",
      "items"
    ],
    "additionalProperties": false,
    "description": "One to four key numbers.",
    "properties": {
      "type": {
        "const": "stats"
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$",
        "description": "Optional, unique in the report. Without it the block is b<position> (b1 is the first block)."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Optional heading above the block."
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": [
            "label",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "The number as shown, with its unit."
            },
            "delta": {
              "description": "Change against the last period: a number or a short signed text such as +6.1 %.",
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              ]
            },
            "good": {
              "enum": [
                "up",
                "down"
              ],
              "description": "Which direction of the delta is good."
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "spark": {
              "type": "array",
              "minItems": 2,
              "maxItems": 60,
              "description": "Recent values for a small line, oldest first.",
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "table": {
    "type": "object",
    "required": [
      "type",
      "columns",
      "rows"
    ],
    "additionalProperties": false,
    "description": "A data table.",
    "properties": {
      "type": {
        "const": "table"
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$",
        "description": "Optional, unique in the report. Without it the block is b<position> (b1 is the first block)."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Optional heading above the block."
      },
      "columns": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "x-rs-unique-key": "key",
        "items": {
          "type": "object",
          "required": [
            "key",
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,32}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "Header text; put the unit here."
            },
            "type": {
              "enum": [
                "text",
                "number",
                "money",
                "percent",
                "delta",
                "status",
                "date"
              ],
              "default": "text"
            },
            "align": {
              "enum": [
                "left",
                "right",
                "center"
              ]
            },
            "good": {
              "enum": [
                "up",
                "down"
              ],
              "description": "Delta columns only: which direction of the change is good; the change is then coloured."
            }
          }
        }
      },
      "rows": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "description": "Cells by column key. A missing cell or null is empty."
        }
      },
      "total": {
        "type": "object",
        "description": "Optional last row in bold, same cells as a row."
      }
    }
  },
