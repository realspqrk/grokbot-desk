  "decide": {
    "type": "object",
    "required": [
      "type",
      "items"
    ],
    "additionalProperties": false,
    "description": "Input: one decision per item.",
    "properties": {
      "type": {
        "const": "decide"
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$",
        "description": "Optional, unique in the report. Without it the block is b<position> (b1 is the first block)."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "Optional heading above the block."
      },
      "labels": {
        "type": "object",
        "additionalProperties": false,
        "description": "Labels of the choices under ask approve. Each choice of an item needs its own label: a label that repeats another choice, or reads like another choice's default label in any UI language, is rejected. Not allowed under ask do.",
        "properties": {
          "approve": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$",
            "description": "Label of the approve choice instead of Approve. The result value stays approve."
          },
          "reject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$",
            "description": "Label of the reject choice instead of Reject. The result value stays reject."
          },
          "later": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$",
            "description": "Label of the later choice instead of Later. The result value stays later."
          }
        }
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "x-rs-unique-key": "id",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,40}$",
              "description": "Unique in the block; echoed in the result."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            },
            "meta": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Short quiet line, e.g. an amount."
            },
            "md": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "Short Markdown detail."
            },
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "description": "Labels of the choices under ask approve. Each choice of an item needs its own label: a label that repeats another choice, or reads like another choice's default label in any UI language, is rejected. Not allowed under ask do.",
              "properties": {
                "approve": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24,
                  "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$",
                  "description": "Label of the approve choice instead of Approve. The result value stays approve."
                },
                "reject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24,
                  "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$",
                  "description": "Label of the reject choice instead of Reject. The result value stays reject."
                },
                "later": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24,
                  "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$",
                  "description": "Label of the later choice instead of Later. The result value stays later."
                }
              }
            },
            "choices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "description": "Choices in this order: approve, reject, later under ask approve; done, skipped, later under ask do.",
              "items": {
                "enum": [
                  "approve",
                  "reject",
                  "later",
                  "done",
                  "skipped"
                ]
              }
            },
            "due": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
              "description": "YYYY-MM-DD, a real calendar day."
            },
            "url": {
              "type": "string",
              "minLength": 8,
              "maxLength": 2048,
              "pattern": "^https?://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.?(?::(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[0-9]{1,4}))?(?:[/?#][^\\x00-\\x1F\\x7F-\\x9F\\s\\\\]*)?$",
              "x-rs-url": true
            },
            "copy": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24,
                    "description": "Button label, e.g. \"Copy reference\"."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000,
                    "description": "Exact string that lands on the clipboard."
                  }
                }
              }
            }
          }
        }
